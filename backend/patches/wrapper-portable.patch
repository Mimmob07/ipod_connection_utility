+#[cfg(test)]
+mod lifecycle_tests {
+    use super::*;
+    use std::os::unix::fs::PermissionsExt;
+    use std::sync::mpsc;
+    use std::sync::Arc;
+
+    #[test]
+    fn restart_cleanup_serializes_concurrent_worker_start() {
+        let unique = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .expect("system clock after epoch")
+            .as_nanos();
+        let script = std::env::temp_dir().join(format!(
+            "wrapperd-dummy-launcher-{}-{unique}",
+            std::process::id(),
+        ));
+        std::fs::write(
+            &script,
+            "#!/bin/sh\ntrap '' TERM\nprintf 'READY\\n'\nwhile IFS= read -r line; do :; done\n",
+        )
+        .expect("write dummy launcher");
+        let mut permissions = std::fs::metadata(&script)
+            .expect("stat dummy launcher")
+            .permissions();
+        permissions.set_mode(0o755);
+        std::fs::set_permissions(&script, permissions).expect("make dummy launcher executable");
+
+        let worker = Arc::new(Worker::new(script.to_str().unwrap(), "test".to_string()));
+        worker.ensure_started().expect("start initial dummy worker");
+        wait_for_ready(&worker);
+        let old_pid = worker.pid.load(Ordering::Relaxed);
+        assert_ne!(old_pid, 0);
+
+        // Queue restart behind this lock so the concurrent ensure_started call
+        // observes the process slot during old-child cleanup.
+        let held = worker.proc.lock().expect("lock worker process slot");
+        let restarting_worker = Arc::clone(&worker);
+        let (restart_started_tx, restart_started_rx) = mpsc::channel();
+        let restart_thread = thread::spawn(move || {
+            restart_started_tx.send(()).unwrap();
+            restarting_worker.restart_after_delay();
+        });
+        restart_started_rx.recv().expect("restart thread started");
+        drop(held);
+
+        let lock_deadline = Instant::now() + Duration::from_millis(500);
+        let restart_holds_slot = loop {
+            match worker.proc.try_lock() {
+                Err(TryLockError::WouldBlock) => break true,
+                Ok(guard) => {
+                    let empty = guard.is_none();
+                    drop(guard);
+                    if empty || Instant::now() >= lock_deadline {
+                        break false;
+                    }
+                    thread::sleep(Duration::from_millis(2));
+                }
+                Err(TryLockError::Poisoned(_)) => panic!("worker process slot poisoned"),
+            }
+        };
+        assert!(
+            restart_holds_slot,
+            "restart cleanup must retain the process mutex while reaping the old child"
+        );
+        assert_eq!(worker.pid.load(Ordering::Relaxed), old_pid);
+
+        let concurrent_worker = Arc::clone(&worker);
+        let (start_result_tx, start_result_rx) = mpsc::channel();
+        let start_thread = thread::spawn(move || {
+            start_result_tx
+                .send(concurrent_worker.ensure_started().is_ok())
+                .unwrap();
+        });
+        assert!(
+            start_result_rx
+                .recv_timeout(Duration::from_millis(100))
+                .is_err(),
+            "concurrent worker start must wait for old-child cleanup"
+        );
+        assert!(start_result_rx
+            .recv_timeout(Duration::from_secs(3))
+            .expect("concurrent worker start completes after cleanup"));
+        start_thread.join().expect("start thread joins");
+        wait_for_ready(&worker);
+        restart_thread.join().expect("restart thread joins");
+
+        let new_pid = worker.pid.load(Ordering::Relaxed);
+        assert_ne!(new_pid, 0);
+        assert_ne!(new_pid, old_pid);
+        assert_eq!(
+            unsafe { libc::kill(new_pid as libc::pid_t, 0) },
+            0,
+            "tracked replacement worker must still be alive"
+        );
+
+        worker.shutdown();
+        assert_eq!(worker.pid.load(Ordering::Relaxed), 0);
+        let _ = std::fs::remove_file(script);
+    }
+
+    fn wait_for_ready(worker: &Worker) {
+        let deadline = Instant::now() + Duration::from_secs(2);
+        let mut output = Vec::new();
+        while Instant::now() < deadline {
+            let mut guard = worker.proc.lock().expect("lock worker process slot");
+            let proc = guard.as_mut().expect("dummy worker exists");
+            let mut byte = [0u8; 1];
+            match proc.stdout.read(&mut byte) {
+                Ok(0) => panic!("dummy launcher closed stdout before readiness"),
+                Ok(_) => {
+                    output.push(byte[0]);
+                    if output.ends_with(b"READY\n") {
+                        return;
+                    }
+                }
+                Err(error) if error.kind() == io::ErrorKind::WouldBlock => {
+                    drop(guard);
+                    thread::sleep(Duration::from_millis(5));
+                }
+                Err(error) if error.kind() == io::ErrorKind::Interrupted => {}
+                Err(error) => panic!("read dummy launcher readiness: {error}"),
+            }
+        }
+        panic!("dummy launcher did not become ready; output={output:?}");
+    }
+}
