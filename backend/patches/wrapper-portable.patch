diff --git a/src/daemon/page_compat.cpp b/src/daemon/page_compat.cpp
new file mode 100644
index 0000000..4ce7c68
--- /dev/null
+++ b/src/daemon/page_compat.cpp
@@ -0,0 +1,27 @@
+// QEMU user emulation keeps the Linux host kernel's discard granularity.
+// On a host page larger than Android's 4 KiB page, forwarding a partial-page
+// MADV_DONTNEED can discard neighboring live jemalloc allocations. The guard
+// is disabled for native profiles by setting WRAPPER_HOST_PAGE_SIZE to 0.
+#include <cerrno>
+#include <cstddef>
+#include <cstdint>
+#include <cstdlib>
+#include <sys/mman.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+extern "C" int madvise(void* address, std::size_t length, int advice) {
+    const char* value = std::getenv("WRAPPER_HOST_PAGE_SIZE");
+    char* end = nullptr;
+    errno = 0;
+    const unsigned long host_page = value ? std::strtoul(value, &end, 10) : 0;
+    const bool valid = value && end && *value && *end == '\0' && errno == 0 &&
+                       host_page > 4096 && (host_page & (host_page - 1)) == 0;
+    if (valid && advice == MADV_DONTNEED &&
+        ((reinterpret_cast<std::uintptr_t>(address) & (host_page - 1)) ||
+         (length & (host_page - 1)))) {
+        errno = EINVAL;
+        return -1;
+    }
+    return static_cast<int>(syscall(SYS_madvise, address, length, advice));
+}
