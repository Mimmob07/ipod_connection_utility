--- /dev/null
+++ b/tools/test-dockerignore.sh
@@ -0,0 +1,33 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
+command -v docker >/dev/null || { echo "test-dockerignore: docker is required" >&2; exit 2; }
+
+TMP=$(mktemp -d "${TMPDIR:-/tmp}/wrapper-dockerignore.XXXXXX")
+trap 'rm -rf "$TMP"' EXIT
+CONTEXT="$TMP/context"
+OUTPUT="$TMP/output"
+mkdir -p "$CONTEXT/rootfs/data/data/com.apple.android.music/files" \
+    "$CONTEXT/data/session" "$CONTEXT/src" "$OUTPUT"
+cp "$REPO_ROOT/.dockerignore" "$CONTEXT/.dockerignore"
+printf 'FROM scratch\nCOPY . /context\n' > "$TMP/Dockerfile"
+
+# Deliberately use non-sensitive markers: the only purpose is to prove these
+# account-state locations are absent from a generated image context.
+printf 'fake-rootfs-session-marker\n' > "$CONTEXT/rootfs/data/data/com.apple.android.music/files/session.json"
+printf 'fake-session-marker\n' > "$CONTEXT/data/session/session.json"
+printf 'fake-env-marker\n' > "$CONTEXT/.env"
+printf 'fake-secret-marker\n' > "$CONTEXT/.env.test"
+printf 'safe-build-input\n' > "$CONTEXT/src/source.cpp"
+
+docker buildx build --quiet --output "type=local,dest=$OUTPUT" \
+    -f "$TMP/Dockerfile" "$CONTEXT"
+
+test -f "$OUTPUT/context/src/source.cpp"
+test ! -e "$OUTPUT/context/rootfs/data/data/com.apple.android.music/files/session.json"
+test ! -e "$OUTPUT/context/data/session/session.json"
+test ! -e "$OUTPUT/context/.env"
+test ! -e "$OUTPUT/context/.env.test"
+echo "test-dockerignore: rootfs account data, data/, and .env files excluded; safe source included"
diff --git a/tools/test-page-compat.cpp b/tools/test-page-compat.cpp
new file mode 100644
index 0000000..be26da3
--- /dev/null
+++ b/tools/test-page-compat.cpp
@@ -0,0 +1,36 @@
+#include <cassert>
+#include <cerrno>
+#include <cstdio>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <sys/mman.h>
+#include <unistd.h>
+
+int main() {
+    const auto page = static_cast<std::size_t>(sysconf(_SC_PAGESIZE));
+    const auto guard_page = page > 16384 ? page : 16384;
+    char setting[32];
+    std::snprintf(setting, sizeof(setting), "%zu", guard_page);
+    setenv("WRAPPER_HOST_PAGE_SIZE", setting, 1);
+    auto* mapping = static_cast<unsigned char*>(mmap(
+        nullptr, 3 * guard_page, PROT_READ | PROT_WRITE,
+        MAP_PRIVATE | MAP_ANONYMOUS, -1, 0));
+    assert(mapping != MAP_FAILED);
+    const auto aligned_value =
+        (reinterpret_cast<std::uintptr_t>(mapping) + guard_page - 1) &
+        ~(guard_page - 1);
+    auto* region = reinterpret_cast<unsigned char*>(aligned_value);
+    std::memset(region, 0x5a, 2 * guard_page);
+
+    assert(madvise(region, 4096, MADV_DONTNEED) == -1 && errno == EINVAL);
+    for (std::size_t i = 0; i < 2 * guard_page; ++i) assert(region[i] == 0x5a);
+    assert(madvise(region, guard_page, MADV_DONTNEED) == 0);
+    for (std::size_t i = 0; i < guard_page; ++i) assert(region[i] == 0);
+    for (std::size_t i = guard_page; i < 2 * guard_page; ++i) assert(region[i] == 0x5a);
+
+    setenv("WRAPPER_HOST_PAGE_SIZE", "0", 1);
+    std::memset(region, 0x5a, page);
+    assert(madvise(region, page, MADV_DONTNEED) == 0);
+    assert(munmap(mapping, 3 * guard_page) == 0);
+}
